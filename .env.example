# Copy to .env and set your local AWS environment values.
AWS_PROFILE=your-profile
AWS_ACCOUNT_ID=your-account-id
AWS_REGION=us-east-1
AWS_SSO_SESSION=your-sso-session
AWS_SSO_START_URL=https://your-sso-portal.awsapps.com/start/
AWS_SSO_REGION=us-east-1
AWS_ROLE_NAME=your-role
BEDROCK_MODEL_ID=your-bedrock-model-or-inference-profile
CODE_INTERPRETER_ID=aws.codeinterpreter.v1
BEDROCK_KNOWLEDGE_BASE=your-knowledge-base-id
BEDROCK_KB_REGION=us-east-1
